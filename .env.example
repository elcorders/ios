# Adapter: mock (default, no backend) or supabase
VITE_API=mock
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Web push (public VAPID key; empty = push off) and dev service worker
VITE_VAPID_PUBLIC_KEY=
VITE_SW_DEV=
# Push UI: on (everyone) | admin (admins only) | off (default)
VITE_FEATURE_PUSH=off
